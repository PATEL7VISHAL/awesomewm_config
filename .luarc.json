{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime": {
        "version": "Lua 5.4",
        "path": [
            "?.lua",
            "?/init.lua"
        ]
    },
    "workspace": {
        "checkThirdParty": false
    },
    "diagnostics": {
        "globals": [
            "awesome",
            "button",
            "client",
            "dbus",
            "drawable",
            "drawin",
            "key",
            "keygrabber",
            "mouse",
            "mousegrabber",
            "root",
            "screen",
            "selection",
            "tag",
            "window"
        ],
        "disable": [
            "unused-local"
        ]
    }
}
